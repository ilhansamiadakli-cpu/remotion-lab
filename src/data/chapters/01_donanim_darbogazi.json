        "title": "zbuffer_bottleneck.c",
        "code": "// 486DX uzerinde her piksel icin Z-Buffer darbogazi\nfor (int p = 0; p < WIDTH * HEIGHT; p++) {\n  if (pixel_depth < zbuffer[p]) {   // RAM oku + karsilastir\n    zbuffer[p] = pixel_depth;       // 32-bit derinlik yaz\n    framebuffer[p] = shade_texel(); // Ayni piksel 5x cizilir!\n  }\n}",
        "diffLines": {
          "remove": [3, 4, 5]
