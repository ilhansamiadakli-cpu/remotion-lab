        "language": "java",
        "title": "r_bsp.c",
        "code": "void RenderBSPNode(BSPNode *node, Vec3 cam) {\n  if (node->isLeaf) { DrawSubsector(node); return; }\n  float side = DotProduct(cam, node->normal) - node->dist;\n  if (side >= 0) { // Kamera duzlemin onunde\n    RenderBSPNode(node->front, cam); // 1. Once on dal\n    RenderBSPNode(node->back,  cam); // 2. Sonra arka dal\n  } else {\n    RenderBSPNode(node->back,  cam);\n    RenderBSPNode(node->front, cam);\n  }\n}",
        "focusSteps": [
