        "language": "java",
        "title": "RezervasyonService.java",
        "code": "@Transactional(isolation = Isolation.READ_COMMITTED)\npublic Rezervasyon olustur(RezervasyonIstegi req) {\n  Oda oda = odaRepo.findByIdForUpdate(req.odaId());\n  boolean cakisiyor = rezRepo.existsOverlap(\n      oda.getId(), req.giris(), req.cikis());\n  if (cakisiyor) throw new OdaDoluException(409);\n  return rezRepo.save(Rezervasyon.yeni(oda, req));\n}",
        "focusSteps": [
